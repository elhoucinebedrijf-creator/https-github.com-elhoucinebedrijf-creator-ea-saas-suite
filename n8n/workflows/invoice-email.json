      "notes": "Getriggerd door de Invoice Generation workflow, of handmatig via de 'Verstuur' actie in het dashboard."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT i.id, i.invoice_number, i.pdf_url, i.payment_url, i.total_incl_btw, c.email AS client_email, c.name AS client_name, t.company_name\nFROM invoices i\nJOIN clients c ON c.id = i.client_id\nJOIN tenants t ON t.id = i.tenant_id\nWHERE i.id = '{{$json.body.invoice_id}}';",
        "options": {}
      },
      "id": "e1fe498b-7d13-4f3a-ac6a-9bd47bc34bd9",
