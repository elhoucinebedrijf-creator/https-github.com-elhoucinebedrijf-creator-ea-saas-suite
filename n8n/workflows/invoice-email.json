        "emailFormat": "text",
        "text": "=Beste {{$('Factuurgegevens ophalen').item.json.client_name}},\n\nBijgevoegd vindt u factuur {{$('Factuurgegevens ophalen').item.json.invoice_number}}.\n\nDirect online betalen (o.a. met iDEAL) kan via deze link:\n{{$('Factuurgegevens ophalen').item.json.payment_url}}\n\nMet vriendelijke groet,\n{{$('Factuurgegevens ophalen').item.json.company_name}}",
        "options": {
          "appendAttribution": false
        }
      },
