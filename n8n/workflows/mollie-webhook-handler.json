    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE subscription_payments SET status = 'paid', paid_at = now() WHERE id = '{{$json.subscription_payment_id}}';\nUPDATE subscriptions SET status = 'active', current_period_start = CURRENT_DATE, current_period_end = CURRENT_DATE + INTERVAL '1 month' WHERE id = '{{$json.subscription_id}}';\nUPDATE tenants SET subscription_status = 'active' WHERE id = '{{$json.tenant_id}}';",
        "options": {}
      },
