    {
      "parameters": {
        "jsCode": "// Vast CSV-sjabloon (v1, zie docs/setup.md):\n// ride_date,pickup_address,dropoff_address,distance_km,amount_excl_btw,client_name,external_ride_id\nconst csvText = $input.first().json.data || $input.first().binary?.data;\nconst text = typeof csvText === 'string' ? csvText : Buffer.from($input.first().binary.data.data, 'base64').toString('utf-8');\nconst lines = text.trim().split(/\\r?\\n/);\nconst header = lines[0].split(',').map(h => h.trim());\nconst rows = lines.slice(1).map(line => {\n  const cols = line.split(',');\n  const row = {};\n  header.forEach((h, i) => (row[h] = (cols[i] || '').trim()));\n  return row;\n});\nreturn rows.map(row => ({ json: row }));"
      },
      "id": "a353e999-e149-4881-92e8-eb476b631cb3",
      "name": "CSV parsen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -144
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO rides (tenant_id, client_id, ride_date, pickup_address, dropoff_address, distance_km, amount_excl_btw, btw_rate, amount_incl_btw, source, file_upload_id, external_ride_id, status, raw_data)\nSELECT\n  '{{$('Geheim geldig?').item.json.body.tenant_id}}',\n  (SELECT id FROM clients WHERE tenant_id = '{{$('Geheim geldig?').item.json.body.tenant_id}}' AND name = '{{$json.client_name}}' LIMIT 1),\n  '{{$json.ride_date}}'::date,\n  '{{$json.pickup_address}}',\n  '{{$json.dropoff_address}}',\n  NULLIF('{{$json.distance_km}}', '')::numeric,\n  ROUND(('{{$json.amount_excl_btw}}')::numeric * 100),\n  9,\n  ROUND(('{{$json.amount_excl_btw}}')::numeric * 100 * 1.09),\n  'csv_upload',\n  '{{$('Upload opzoeken').item.json.id}}',\n  '{{$json.external_ride_id}}',\n  'unbilled',\n  '{{JSON.stringify($json)}}'::jsonb;",
        "options": {}
      },
      "id": "6c7c8744-714e-4fde-974c-4141f2519006",
      "name": "Rit toevoegen (per rij)",
